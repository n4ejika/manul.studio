Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On

# One canonical protocol, host and directory URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ https://manul.studio/$1 [R=301,L,NE]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^manul\.studio$ [NC]
RewriteRule ^ https://manul.studio%{REQUEST_URI} [R=301,L,NE]

# Language and route migration.
RewriteRule ^en/?$ https://manul.studio/ [R=301,L,NE]
RewriteRule ^sozdanie-saytov/?$ https://manul.studio/ru/sozdanie-saytov/ [R=301,L,NE]
RewriteRule ^en/sozdanie-saytov/?$ https://manul.studio/website-development/ [R=301,L,NE]
RewriteRule ^korporativnyj-sajt/?$ https://manul.studio/ru/korporativnyj-sajt/ [R=301,L,NE]
RewriteRule ^en/korporativnyj-sajt/?$ https://manul.studio/corporate-website-development/ [R=301,L,NE]
RewriteRule ^landing/?$ https://manul.studio/ru/landing/ [R=301,L,NE]
RewriteRule ^en/landing/?$ https://manul.studio/landing-page-development/ [R=301,L,NE]
RewriteRule ^redizajn-sajta/?$ https://manul.studio/ru/redizajn-sajta/ [R=301,L,NE]
RewriteRule ^en/redizajn-sajta/?$ https://manul.studio/website-redesign/ [R=301,L,NE]
RewriteRule ^seo-prodvizhenie/?$ https://manul.studio/ru/seo-prodvizhenie/ [R=301,L,NE]
RewriteRule ^en/seo-prodvizhenie/?$ https://manul.studio/seo-services/ [R=301,L,NE]
RewriteRule ^nastrojka-yandex-direkt/?$ https://manul.studio/ru/nastrojka-yandex-direkt/ [R=301,L,NE]
RewriteRule ^en/nastrojka-yandex-direkt/?$ https://manul.studio/google-ads-management/ [R=301,L,NE]
RewriteRule ^podderzhka-sajta/?$ https://manul.studio/ru/podderzhka-sajta/ [R=301,L,NE]
RewriteRule ^en/podderzhka-sajta/?$ https://manul.studio/website-support/ [R=301,L,NE]
RewriteRule ^soprovozhdenie-sajta/?$ https://manul.studio/ru/soprovozhdenie-sajta/ [R=301,L,NE]
RewriteRule ^en/soprovozhdenie-sajta/?$ https://manul.studio/website-management/ [R=301,L,NE]
RewriteRule ^medicinskie-sajty/?$ https://manul.studio/ru/medicinskie-sajty/ [R=301,L,NE]
RewriteRule ^en/medicinskie-sajty/?$ https://manul.studio/medical-website-development/ [R=301,L,NE]
RewriteRule ^sajty-dlya-stomatologij/?$ https://manul.studio/ru/sajty-dlya-stomatologij/ [R=301,L,NE]
RewriteRule ^en/sajty-dlya-stomatologij/?$ https://manul.studio/dental-website-development/ [R=301,L,NE]
RewriteRule ^cases/?$ https://manul.studio/ru/cases/ [R=301,L,NE]
RewriteRule ^en/cases/?$ https://manul.studio/case-studies/ [R=301,L,NE]
RewriteRule ^cases/okean/?$ https://manul.studio/ru/cases/okean/ [R=301,L,NE]
RewriteRule ^en/cases/okean/?$ https://manul.studio/case-studies/ocean-dental-clinic/ [R=301,L,NE]
RewriteRule ^cases/i-sev/?$ https://manul.studio/ru/cases/i-sev/ [R=301,L,NE]
RewriteRule ^en/cases/i-sev/?$ https://manul.studio/case-studies/i-sev/ [R=301,L,NE]
RewriteRule ^cases/crimea-print/?$ https://manul.studio/ru/cases/crimea-print/ [R=301,L,NE]
RewriteRule ^en/cases/crimea-print/?$ https://manul.studio/case-studies/crimea-print/ [R=301,L,NE]
RewriteRule ^cases/luca-pacioli/?$ https://manul.studio/ru/cases/luca-pacioli/ [R=301,L,NE]
RewriteRule ^en/cases/luca-pacioli/?$ https://manul.studio/case-studies/luca-pacioli/ [R=301,L,NE]
RewriteRule ^studio/?$ https://manul.studio/ru/studio/ [R=301,L,NE]
RewriteRule ^en/studio/?$ https://manul.studio/about/ [R=301,L,NE]
RewriteRule ^contacts/?$ https://manul.studio/ru/contacts/ [R=301,L,NE]
RewriteRule ^en/contacts/?$ https://manul.studio/contact/ [R=301,L,NE]
RewriteRule ^privacy/?$ https://manul.studio/ru/privacy/ [R=301,L,NE]
RewriteRule ^en/privacy/?$ https://manul.studio/privacy-policy/ [R=301,L,NE]
RewriteRule ^consent/?$ https://manul.studio/ru/consent/ [R=301,L,NE]
RewriteRule ^en/consent/?$ https://manul.studio/data-processing-consent/ [R=301,L,NE]
RewriteRule ^ae/ar/?$ https://manul.studio/ar/uae/ [R=301,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
